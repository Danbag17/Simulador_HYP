{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/calculate",
      "destination": "https://context-background-classified-contain.trycloudflare.com"
    },
    {
      "source": "/api/comandos",
      "destination": "https://context-background-classified-contain.trycloudflare.com"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}