{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/calculate(.*)",
      "destination": "https://setting-commercial-gui-courtesy.trycloudflare.com/api/calculate$1"
    },
    {
      "source": "/api/comandos",
      "destination": "https://setting-commercial-gui-courtesy.trycloudflare.com/api/command"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}