{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/calculate",
      "destination": "https://samuel-fifteen-diana-properties.trycloudflare.com/api/calculate"
    },
    {
      "source": "/api/comandos",
      "destination": "https://samuel-fifteen-diana-properties.trycloudflare.com/api/command"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}